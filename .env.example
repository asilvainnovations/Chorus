# .env.example — Copy to .env and fill in your API keys

# OpenRouter API Key (Required for all AI chat functionality)
# Get yours at: https://openrouter.ai/keys
VITE_OPENROUTER_API_KEY=sk-or-v1-your-openrouter-api-key-here

# Tavily API Key (Required for RAG web search)
# Get yours at: https://tavily.com/
VITE_TAVILY_API_KEY=tvly-your-tavily-api-key-here

# Optional: Replicate API Key (for advanced image generation)
# Get yours at: https://replicate.com/
VITE_REPLICATE_API_TOKEN=r8_your-replicate-token-here

# Optional: Product analytics
VITE_POSTHOG_KEY=phc_your-posthog-key
VITE_POSTHOG_HOST=https://your-posthog-host

# Build configuration
VITE_APP_NAME=Huli Ka
VITE_APP_VERSION=1.0.0
